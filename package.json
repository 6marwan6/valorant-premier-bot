{
  "name": "valorant-premier-bot",
  "version": "0.1.0",
  "description": "Private Discord AI assistant for a Valorant Premier team (see Full_Development_Plan.md).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vercel dev",
    "deploy-commands": "tsx src/scripts/deployCommands.ts",
    "validate-commands": "tsx src/scripts/validateCommands.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "discord-api-types": "^0.38.55",
    "discord-interactions": "^4.4.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "luxon": "^3.7.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@vercel/node": "^13.0.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
