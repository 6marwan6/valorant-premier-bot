# --- Discord (plan section 52) ---
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# From the Discord Developer Portal's "General Information" tab. Required
# for verifying that incoming interaction requests really came from
# Discord (see src/discord/verifyInteraction.ts) — the app is deployed as
# an HTTP Interactions endpoint (Vercel function), not a gateway
# connection, so this signature check IS the authentication. See README
# "Hosting & Deployment".
DISCORD_PUBLIC_KEY=

# --- Database (plan section 52) ---
# PostgreSQL connection string. For Neon specifically, use the POOLED
# connection string (the one with "-pooler" in the hostname) — Vercel
# functions are short-lived and stateless, so each invocation opens its
# own connection; Neon's PgBouncer pooler is designed for exactly that.
# No code changes needed either way — same driver, same query builder.
DATABASE_URL=

# --- AI (plan section 52) ---
# Not used yet — Phase 1 ships with no AI. Required starting Phase 6.
LLM_API_KEY=

# --- Cron (plan section 52, Phase 4) ---
# Shared secret the external cron scheduler (cron-job.org / Upstash
# QStash — see README "Hosting & Deployment") must send as
# `Authorization: Bearer <CRON_SECRET>` when it hits /api/cron/reminders.
# Generate any long random string; the endpoint refuses every request
# when this is unset, so don't skip it in production.
CRON_SECRET=

# --- Bootstrap defaults (plan section 52 & 53) ---
# These only seed the very first boot. Once an admin runs /setup, the
# database row in server_config becomes the source of truth (plan section 53:
# "Keep configuration in the database where appropriate rather than
# hardcoding it") and these env vars are ignored for that guild.
#
# NOTE ON TIMEZONE: the plan (section 3) says "Use Europe/frankfurt as the
# team's default timezone", but "Europe/Frankfurt" is not a valid IANA time
# zone identifier (Germany has a single zone: "Europe/Berlin"). Resolved to
# "Africa/Cairo" — plan section 11's own worked example, and the team is
# Cairo-based. Override here (or via /setup) if the team is elsewhere.
DEFAULT_TIMEZONE=
MATCH_CHANNEL_ID=
ADMIN_ROLE_ID=

# --- Misc ---
NODE_ENV=development
LOG_LEVEL=info

# --- Gateway worker (2026-09-29, plan section 4's note) ---
# Set to "true" ONLY where worker/gateway.ts runs (Railway): typed DMs
# to the bot are then instant, so DM chat replies drop the "Tap Reply" button.
# On the Vercel deployment leave it unset/"false". The worker needs the same
# variables as Vercel (DISCORD_BOT_TOKEN, DISCORD_CLIENT_ID, DISCORD_GUILD_ID,
# DISCORD_PUBLIC_KEY, DATABASE_URL, LLM_*) — it never serves interactions.
GATEWAY_WORKER=false

# --- Voice (gateway worker only; off unless GROQ_API_KEY is set) ---
# One key, or several separated by commas (GROQ_API_KEY=gsk_a,gsk_b): when one hits its limit / runs out of
# credit / is refused (429, 402, 401) the next one is used automatically. Same for DEEPGRAM_API_KEY and LLM_API_KEY.
# /mari-voice (voice notes) runs in the Vercel app, so set GROQ_API_KEY (and any VOICE_* you changed) there too.
GROQ_API_KEY=
# Speech-to-text engine: Deepgram Nova-3 when this is set, with Groq Whisper as the automatic fallback.
DEEPGRAM_API_KEY=
# auto (default: deepgram if a key is set) | deepgram | groq
VOICE_STT_PROVIDER=auto
VOICE_DEEPGRAM_MODEL=nova-3
# The voice channel she joins by herself whenever a roster player is in it (re-checked every ~15 s, so a
# player who was already in there is picked up too). EMPTY = she joins only through /mari-join.
VOICE_CHANNEL_ID=
# Orpheus voice: autumn | diana | hannah (default) | austin | daniel | troy
VOICE_NAME=hannah
# Delivery word sent to Orpheus as [word]. Default (leave blank): flirty. "none" = no direction.
# Counts toward its 200-char limit.
VOICE_DIRECTION=
# Pitch multiplier, 1 = unchanged. Default (blank): 1.08 (a little higher and quicker = younger, more energetic)
VOICE_PITCH=
# Quiet time (ms) that ends an utterance, 300-2000. Lower = she answers sooner but may cut people off.
VOICE_SILENCE_MS=700
# Whether she needs to hear her name: auto (no name needed only while ONE person is with her) | name | always.
# /mari-join listen:... overrides it per session.
VOICE_LISTEN=auto
# On joining she looks up the players already in the channel (database only, NO Groq/Deepgram requests).
# full = ALSO send a /models call + one throw-away TTS word to Groq on every join (a little faster first answer,
# but it costs requests each time). 0 = no warm-up at all.
VOICE_WARMUP=1
# Utterances whose loudest 100 ms is quieter than this (RMS, 0-32768) are breath / key clicks / room noise and are
# dropped locally instead of costing a speech-to-text request. Default 250. 0 = off. Raise it if background noise
# still gets transcribed; lower it if a quiet speaker is being ignored (log line: "Voice utterance: tooQuiet").
VOICE_MIN_LEVEL=250
# Optional: use a different (faster) model ONLY for spoken replies. Leave empty to use LLM_MODEL for voice too.
# It is sent to the same provider/base URL/key as LLM_MODEL, so it must be a model that provider serves.
# Optional output cap for spoken replies.
# Leave the cap unset unless replies get cut off or you need it shorter still.
VOICE_LLM_MODEL=
VOICE_LLM_MAX_TOKENS=
# VOICE_NAME / VOICE_DIRECTION / VOICE_PITCH are only defaults: /mari-join can override voice, direction
# and pitch per session (see docs/VOICE.md).
# Speech-to-text: Groq Whisper model (whisper-large-v3 = more accurate; whisper-large-v3-turbo = a little faster)
VOICE_STT_MODEL=whisper-large-v3
# "auto" hears English AND Arabic (default). A fixed code (en / ar) is more reliable if you only ever speak one.
VOICE_STT_LANGUAGE=auto
# Arabic speech (Groq Orpheus Arabic, Saudi accent, no [direction]). 0 = Arabic text is spoken by the English
# voice (bad). You must accept the model's terms once in the Groq console, or Arabic speech returns HTTP 400.
VOICE_ARABIC=1
VOICE_TTS_ARABIC_MODEL=canopylabs/orpheus-arabic-saudi
# Arabic voice: noura / lulwa (female), fahad / sultan (male)
VOICE_NAME_AR=noura
# 1 = verbose voice logs, she greets out loud on join. Turn off after testing.
VOICE_DEBUG=0

# --- Railway (gateway worker service only; see docs/RAILWAY.md) ---
# Set these on the Railway service, not in Vercel.
# Give the old container 10 s between SIGTERM and SIGKILL so the worker's
# shutdown handler can leave voice, close the Discord client and end the pool.
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=10
